# Use OpenResty (Nginx + Lua) on Ubuntu 24.04 (noble) as the base
FROM openresty/openresty:noble

# to avoid interactive prompts in some distros:
ENV DEBIAN_FRONTEND=noninteractive

# Install any additional packages you need (cron, wget, etc.)
RUN apt-get update && apt-get install -y \
    wget \
    cron \
    dnsutils \
    && apt-get clean

# NOTE: the Nginx Ultimate Bad Bot Blocker was removed 2026-07-09 (retired in favour
# of CrowdSec http-bad-user-agent + cas/ai-crawler + the CAS $is_bot map in nginx.conf).
# Copy your main nginx.conf into the container
COPY nginx.conf /etc/nginx/
COPY views/robots.txt /srv/app/views/robots.txt

RUN /usr/local/openresty/bin/opm get openresty/lua-resty-string

COPY /lua/s3_sign.lua /usr/local/openresty/nginx/lua/s3_sign.lua

# CrowdSec AppSec: lua HTTP client + error pages (403/503 were missing -> 404)
RUN /usr/local/openresty/bin/opm get ledgetech/lua-resty-http
COPY views/403.html views/503.html /srv/app/views/
